# Hermes Collector API config
# Скопируй этот файл как config/.env и заполни значения.
# config/.env в .gitignore — не коммитится.

# Bearer token для авторизации API запросов.
# Если оставить пустым — auth disabled (только localhost).
# Для внешнего доступа ОБЯЗАТЕЛЬНО задать (минимум 32 случайных символа).
HERMES_COLLECTOR_TOKEN=

# Host на котором слушает API.
# 127.0.0.1 = только localhost (по умолчанию, безопасно)
# 0.0.0.0   = внешний доступ (требует TOKEN!)
COLLECTOR_HOST=127.0.0.1

# Port. По умолчанию 8765 (нестандартный, чтобы избежать конфликтов).
COLLECTOR_PORT=8765
